{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eunomia:vhub:schema:client-config:v1",
  "title": "Configuración del vhub-client v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "space",
    "trust",
    "upstreams",
    "listeners",
    "events"
  ],
  "properties": {
    "space": {
      "type": "string",
      "format": "iri"
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hub_did",
        "hub",
        "credentials"
      ],
      "properties": {
        "hub_did": {
          "type": "string",
          "pattern": "^did:web:[A-Za-z0-9._%:-]+$"
        },
        "hub": {
          "type": "string",
          "pattern": "^https://"
        },
        "credentials": {
          "type": "string",
          "pattern": "^file:"
        },
        "did_ttl": {
          "type": "string",
          "pattern": "^P(?=[0-9]|T[0-9])([0-9]+D)?(T([0-9]+H)?([0-9]+M)?([0-9]+S)?)?$",
          "default": "PT6H"
        }
      }
    },
    "upstreams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dsp"
      ],
      "properties": {
        "dsp": {
          "type": "string",
          "format": "uri"
        },
        "management": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "listeners": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admin"
      ],
      "properties": {
        "dsp-ingress": {
          "$ref": "#/$defs/listener"
        },
        "mgmt-ingress": {
          "$ref": "#/$defs/listener"
        },
        "dsp-egress": {
          "$ref": "#/$defs/listener"
        },
        "admin": {
          "$ref": "#/$defs/listener"
        }
      }
    },
    "routes": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "default_action": {
      "enum": [
        "forward",
        "reject"
      ],
      "default": "forward"
    },
    "unknown_agreement": {
      "enum": [
        "forward",
        "reject"
      ],
      "default": "forward"
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "window": {
          "type": "integer",
          "minimum": 1,
          "default": 100
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sink"
      ],
      "properties": {
        "sink": {
          "type": "string",
          "pattern": "^(file:|http:|https:)"
        }
      }
    }
  },
  "$defs": {
    "listener": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bind"
      ],
      "properties": {
        "bind": {
          "type": "string",
          "pattern": "^[^:]+:[0-9]{1,5}$"
        }
      }
    },
    "message": {
      "enum": [
        "CatalogRequestMessage",
        "DatasetRequestMessage",
        "ContractRequestMessage",
        "ContractOfferMessage",
        "ContractAgreementMessage",
        "ContractAgreementVerificationMessage",
        "ContractNegotiationEventMessage",
        "ContractNegotiationTerminationMessage",
        "TransferRequestMessage",
        "TransferStartMessage",
        "TransferSuspensionMessage",
        "TransferCompletionMessage",
        "TransferTerminationMessage",
        "management"
      ]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "listener",
        "match",
        "message",
        "gates"
      ],
      "properties": {
        "listener": {
          "enum": [
            "dsp-ingress",
            "mgmt-ingress",
            "dsp-egress"
          ]
        },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "path"
          ],
          "properties": {
            "method": {
              "enum": [
                "GET",
                "POST",
                "PUT",
                "PATCH",
                "DELETE"
              ]
            },
            "path": {
              "type": "string",
              "pattern": "^(/([A-Za-z0-9._~-]+|:[A-Za-z][A-Za-z0-9_]*))+$"
            }
          }
        },
        "message": {
          "$ref": "#/$defs/message"
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "dsp_message",
              "policy_intake",
              "catalog_entry",
              "agreement_admission"
            ]
          }
        },
        "mode": {
          "enum": [
            "observe",
            "shadow",
            "enforce"
          ],
          "default": "observe"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "select": {
              "type": "string",
              "pattern": "^\\$",
              "default": "$"
            }
          }
        },
        "validate_response": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gate"
          ],
          "properties": {
            "gate": {
              "const": "catalog_entry"
            },
            "mode": {
              "enum": [
                "observe",
                "shadow"
              ],
              "default": "shadow"
            }
          }
        }
      }
    }
  }
}
