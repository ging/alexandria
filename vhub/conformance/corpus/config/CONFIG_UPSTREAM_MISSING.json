{
  "space": "https://example.com/spaces/demo",
  "trust": {
    "hub_did": "did:web:hub.example.com",
    "hub": "https://hub.example.com",
    "credentials": "file:corpus/config/credentials.json"
  },
  "upstreams": {
    "dsp": "http://connector:8282/protocol"
  },
  "listeners": {
    "admin": {
      "bind": "127.0.0.1:9900"
    }
  },
  "routes": [
    {
      "listener": "mgmt-ingress",
      "match": {
        "method": "POST",
        "path": "/v3/policydefinitions"
      },
      "message": "management",
      "gates": [
        "policy_intake"
      ]
    }
  ],
  "events": {
    "sink": "file:corpus/config/events.jsonl"
  }
}
