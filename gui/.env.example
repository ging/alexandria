# Upstream targets proxied by the Vite dev/preview server (copy to .env.local to override).
ALEXANDRIA_HUB_URL=https://127.0.0.1:8443
ALEXANDRIA_CLIENT_ADMIN_URL=http://127.0.0.1:9090
# OIDC issuer whose discovery, token and userinfo endpoints are proxied under /api/idp (avoids IdP CORS setup in the lab).
ALEXANDRIA_OIDC_ISSUER=http://127.0.0.1:9400
