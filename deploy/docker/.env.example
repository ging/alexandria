# Dominios públicos servidos por Caddy.
# En local, *.127.0.0.1.nip.io resuelve automáticamente a 127.0.0.1 sin tocar /etc/hosts.
# En producción con dominio real: HUB_DOMAIN=hub.ejemplo.es, AUTH_DOMAIN=auth.ejemplo.es, HTTPS_PORT=443, CADDY_TLS=ops@ejemplo.es
HUB_DOMAIN=hub.127.0.0.1.nip.io
AUTH_DOMAIN=auth.127.0.0.1.nip.io
HTTPS_PORT=8443

# Modo TLS en Caddy:
# - "internal" emite certificados locales firmados por la CA interna de Caddy (desarrollo / laboratorio).
# - Un email (p. ej. "ops@ejemplo.es") activa Let's Encrypt automático en producción (requiere HTTPS_PORT=443 accesible desde internet).
CADDY_TLS=internal

# Credenciales de PostgreSQL (instancia compartida con 3 bases aisladas: keycloak, alexandria_hub, alexandria_client).
POSTGRES_USER=alexandria
POSTGRES_PASSWORD=alexandria
POSTGRES_PORT=5432

# Consola de administración de Keycloak (https://auth.127.0.0.1.nip.io:8443/admin/).
KEYCLOAK_TAG=26.2
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Perfil opcional "demo" (alexandria-client + fake-connector):
# Si HUB_DID se deja vacío, start-client.sh descubre automáticamente el did:key del Hub al arrancar.
HUB_DID=
CLIENT_NAMESPACE=mobility
