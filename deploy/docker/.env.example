# Public hostnames served by Caddy.
# Locally, *.127.0.0.1.nip.io resolves to 127.0.0.1 without editing /etc/hosts.
# For production: HUB_DOMAIN=hub.example.org, AUTH_DOMAIN=auth.example.org, HTTPS_PORT=443, CADDY_TLS=ops@example.org
HUB_DOMAIN=hub.127.0.0.1.nip.io
AUTH_DOMAIN=auth.127.0.0.1.nip.io
HTTPS_PORT=8443

# Caddy TLS mode:
# - "internal" signs local certificates with Caddy's internal CA (development / lab).
# - An email address (for example "ops@example.org") enables Let's Encrypt (requires HTTPS_PORT=443 reachable from the internet).
CADDY_TLS=internal

# PostgreSQL credentials (shared instance with 3 databases: keycloak, alexandria_hub, alexandria_client).
POSTGRES_USER=alexandria
POSTGRES_PASSWORD=alexandria
POSTGRES_PORT=5432

# Keycloak admin console (https://auth.127.0.0.1.nip.io:8443/admin/).
KEYCLOAK_TAG=26.2
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Optional "demo" profile (alexandria-client + fake-connector):
# If HUB_DID is left empty, start-client.sh discovers the Hub did:key at startup.
HUB_DID=
CLIENT_NAMESPACE=mobility
