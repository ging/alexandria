{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vhub:poc:schema:server-config:v1",
  "title": "vhub-server PoC configuration (DP-12, not normative)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "listen",
    "public_base_url",
    "did",
    "sqlite_path",
    "blob_dir",
    "signing_key_path",
    "tokens_path"
  ],
  "properties": {
    "listen": {
      "type": "string",
      "pattern": "^[^:]*:[0-9]{1,5}$"
    },
    "public_base_url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "did": {
      "type": "string",
      "pattern": "^did:web:[A-Za-z0-9._%:-]+$"
    },
    "sqlite_path": {
      "type": "string",
      "minLength": 1
    },
    "blob_dir": {
      "type": "string",
      "minLength": 1
    },
    "signing_key_path": {
      "type": "string",
      "minLength": 1
    },
    "tokens_path": {
      "type": "string",
      "minLength": 1
    },
    "clock_file": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ttl": {
              "$ref": "#/$defs/duration"
            },
            "max_staleness": {
              "$ref": "#/$defs/duration"
            }
          }
        },
        "grace_window": {
          "$ref": "#/$defs/duration"
        },
        "sync_interval": {
          "$ref": "#/$defs/duration"
        },
        "clock_skew": {
          "$ref": "#/$defs/duration"
        },
        "lease_margin": {
          "$ref": "#/$defs/duration"
        },
        "propagation_window": {
          "$ref": "#/$defs/duration"
        },
        "max_concurrent_versions": {
          "type": "integer",
          "minimum": 1
        },
        "degraded": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "continue",
              "reject"
            ]
          }
        }
      }
    },
    "compiler": {
      "enum": [
        "poc",
        "dsl"
      ],
      "default": "poc",
      "description": "poc: JSON drafts of Part 5.1; dsl: YAML bundles of eunomia.profiles/v1"
    },
    "vendor_dir": {
      "type": "string",
      "minLength": 1,
      "description": "local copies of vendored profiles: <slot>/<version>/vendor.json"
    }
  },
  "$defs": {
    "duration": {
      "type": "string",
      "pattern": "^P([0-9]+D)?(T([0-9]+H)?([0-9]+M)?([0-9]+S)?)?$"
    }
  }
}
