{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/alexandria-vhub/schemas/rules/v1",
  "title": "Conjunto de reglas del vhub-client v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision",
    "rules"
  ],
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "priority",
        "listener",
        "match",
        "message",
        "verify"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "description": {
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        },
        "listener": {
          "enum": [
            "dsp-ingress",
            "mgmt-ingress",
            "dsp-egress"
          ]
        },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "path"
          ],
          "properties": {
            "method": {
              "enum": [
                "GET",
                "POST",
                "PUT",
                "PATCH",
                "DELETE"
              ]
            },
            "path": {
              "type": "string",
              "pattern": "^(/([A-Za-z0-9._~-]+|\\{[A-Za-z][A-Za-z0-9_]*\\}))+$"
            },
            "body": {
              "type": "array",
              "default": [],
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        "message": {
          "enum": [
            "CatalogRequestMessage",
            "DatasetRequestMessage",
            "ContractRequestMessage",
            "ContractOfferMessage",
            "ContractAgreementMessage",
            "ContractAgreementVerificationMessage",
            "ContractNegotiationEventMessage",
            "ContractNegotiationTerminationMessage",
            "TransferRequestMessage",
            "TransferStartMessage",
            "TransferSuspensionMessage",
            "TransferCompletionMessage",
            "TransferTerminationMessage",
            "management"
          ]
        },
        "verify": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gates"
          ],
          "properties": {
            "select": {
              "type": "string",
              "pattern": "^(/([^~/]|~[01])*)*$",
              "default": ""
            },
            "gates": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "dsp_message",
                  "policy_intake",
                  "catalog_entry",
                  "agreement_admission"
                ]
              }
            }
          }
        },
        "mode": {
          "enum": [
            "observe",
            "shadow",
            "enforce"
          ],
          "default": "observe"
        },
        "validate_response": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gate"
          ],
          "properties": {
            "gate": {
              "const": "catalog_entry"
            },
            "mode": {
              "enum": [
                "observe",
                "shadow"
              ],
              "default": "shadow"
            }
          }
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pointer"
      ],
      "properties": {
        "pointer": {
          "type": "string",
          "pattern": "^(/([^~/]|~[01])*)*$"
        },
        "exists": {
          "type": "boolean"
        },
        "equals": {},
        "one_of": {
          "type": "array",
          "minItems": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "exists"
          ]
        },
        {
          "required": [
            "equals"
          ]
        },
        {
          "required": [
            "one_of"
          ]
        }
      ]
    }
  }
}
