{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/alexandria-vhub/schemas/event-verdict/v1",
  "title": "Evento vhub.verdict v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id",
    "ts",
    "namespace",
    "listener",
    "rule",
    "rules_revision",
    "message",
    "gate",
    "mode",
    "state",
    "classification",
    "action",
    "evaluated",
    "matched",
    "codes",
    "findings"
  ],
  "properties": {
    "type": {
      "const": "vhub.verdict"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "ts": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "namespace": {
      "type": "string",
      "format": "iri"
    },
    "listener": {
      "enum": [
        "dsp-ingress",
        "mgmt-ingress",
        "dsp-egress"
      ]
    },
    "rule": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "rules_revision": {
      "type": "integer",
      "minimum": 0
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "gate": {
      "enum": [
        "dsp_message",
        "policy_intake",
        "catalog_entry",
        "agreement_admission"
      ]
    },
    "mode": {
      "enum": [
        "shadow",
        "enforce"
      ]
    },
    "state": {
      "enum": [
        "Onboarding",
        "Active",
        "Transition",
        "Degraded",
        "FailClosed"
      ]
    },
    "classification": {
      "enum": [
        "ok",
        "warning",
        "violation"
      ]
    },
    "action": {
      "enum": [
        "forward",
        "forward-notice",
        "reject"
      ]
    },
    "evaluated": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
      }
    },
    "matched": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sunset": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)+$"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "source",
        "severity",
        "message"
      ],
      "properties": {
        "slot": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "json-schema",
            "shacl",
            "loader"
          ]
        },
        "severity": {
          "enum": [
            "Violation",
            "Warning",
            "Info"
          ]
        },
        "focus": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
