{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eunomia:vhub:schema:version:v1",
  "title": "Registro de versión v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "signed",
    "signature"
  ],
  "properties": {
    "signed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "space",
        "issued_at",
        "record"
      ],
      "properties": {
        "type": {
          "const": "eunomia.version/v1"
        },
        "space": {
          "type": "string",
          "format": "iri"
        },
        "issued_at": {
          "$ref": "#/$defs/instant"
        },
        "record": {
          "$ref": "#/$defs/record"
        }
      }
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "ni": {
      "type": "string",
      "pattern": "^ni:///sha-256;[A-Za-z0-9_-]+$"
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "manifest",
        "class",
        "emergency",
        "published_at",
        "new_content_from",
        "enforced_from",
        "revoked_from"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/semver"
        },
        "manifest": {
          "$ref": "#/$defs/ni"
        },
        "class": {
          "enum": [
            "initial",
            "compatible",
            "breaking"
          ]
        },
        "emergency": {
          "type": "boolean"
        },
        "published_at": {
          "$ref": "#/$defs/instant"
        },
        "new_content_from": {
          "$ref": "#/$defs/instant"
        },
        "enforced_from": {
          "$ref": "#/$defs/instant"
        },
        "revoked_from": {
          "oneOf": [
            {
              "$ref": "#/$defs/instant"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kid",
        "alg",
        "sig"
      ],
      "properties": {
        "kid": {
          "type": "string",
          "pattern": "^did:web:[^#]+#.+$"
        },
        "alg": {
          "const": "EdDSA"
        },
        "sig": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    }
  }
}
