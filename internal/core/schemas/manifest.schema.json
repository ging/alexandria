{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/alexandria-vhub/schemas/manifest/v1",
  "title": "Manifiesto de paquete v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "@context",
    "type",
    "issuer",
    "validFrom",
    "credentialSubject",
    "proof"
  ],
  "properties": {
    "@context": {
      "type": "array",
      "prefixItems": [
        {
          "const": "https://www.w3.org/ns/credentials/v2"
        },
        {
          "type": "string",
          "format": "iri"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "type": {
      "type": "array",
      "prefixItems": [
        {
          "const": "VerifiableCredential"
        },
        {
          "const": "PackageManifest"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "issuer": {
      "type": "string",
      "pattern": "^did:(web:[A-Za-z0-9._%:-]+|key:z[1-9A-HJ-NP-Za-km-z]+)$"
    },
    "validFrom": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "credentialSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "namespace",
        "version",
        "lifecycle",
        "files"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "iri"
        },
        "namespace": {
          "type": "string",
          "format": "iri"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle"
        },
        "profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "iri"
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          }
        }
      }
    },
    "proof": {
      "$ref": "#/$defs/proof"
    }
  },
  "$defs": {
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "cryptosuite",
        "created",
        "verificationMethod",
        "proofPurpose",
        "proofValue"
      ],
      "properties": {
        "type": {
          "const": "DataIntegrityProof"
        },
        "cryptosuite": {
          "const": "eddsa-jcs-2022"
        },
        "created": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "verificationMethod": {
          "type": "string",
          "pattern": "^did:(web|key):[^#]+#.+$"
        },
        "proofPurpose": {
          "const": "assertionMethod"
        },
        "proofValue": {
          "type": "string",
          "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$"
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freshness",
        "min_grace_window",
        "grace_window",
        "sync_interval",
        "clock_skew",
        "lease_margin",
        "propagation_window",
        "max_concurrent_versions",
        "degraded"
      ],
      "properties": {
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ttl",
            "max_staleness"
          ],
          "properties": {
            "ttl": {
              "type": "string",
              "pattern": "^P(?=[0-9]|T[0-9])([0-9]+D)?(T([0-9]+H)?([0-9]+M)?([0-9]+S)?)?$"
            },
            "max_staleness": {
              "type": "string",
              "pattern": "^P(?=[0-9]|T[0-9])([0-9]+D)?(T([0-9]+H)?([0-9]+M)?([0-9]+S)?)?$"
            }
          }
        },
        "min_grace_window": {
          "type": "string",
          "pattern": "^P(?=[0-9]|T[0-9])([0-9]+D)?(T([0-9]+H)?([0-9]+M)?([0-9]+S)?)?$"
        },
        "grace_window": {
          "type": "string",
          "pattern": "^P(?=[0-9]|T[0-9])([0-9]+D)?(T([0-9]+H)?([0-9]+M)?([0-9]+S)?)?$"
        },
        "sync_interval": {
          "type": "string",
          "pattern": "^P(?=[0-9]|T[0-9])([0-9]+D)?(T([0-9]+H)?([0-9]+M)?([0-9]+S)?)?$"
        },
        "clock_skew": {
          "type": "string",
          "pattern": "^P(?=[0-9]|T[0-9])([0-9]+D)?(T([0-9]+H)?([0-9]+M)?([0-9]+S)?)?$"
        },
        "lease_margin": {
          "type": "string",
          "pattern": "^P(?=[0-9]|T[0-9])([0-9]+D)?(T([0-9]+H)?([0-9]+M)?([0-9]+S)?)?$"
        },
        "propagation_window": {
          "type": "string",
          "pattern": "^P(?=[0-9]|T[0-9])([0-9]+D)?(T([0-9]+H)?([0-9]+M)?([0-9]+S)?)?$"
        },
        "max_concurrent_versions": {
          "type": "integer",
          "minimum": 2
        },
        "degraded": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dsp_message": {
              "enum": [
                "continue",
                "reject"
              ]
            },
            "policy_intake": {
              "enum": [
                "continue",
                "reject"
              ]
            },
            "catalog_entry": {
              "enum": [
                "continue",
                "reject"
              ]
            },
            "agreement_admission": {
              "enum": [
                "continue",
                "reject"
              ]
            }
          }
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "media_type",
        "digest",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]+(/[A-Za-z0-9._~-]+)*$"
        },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z]+/[A-Za-z0-9.+-]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^ni:///sha-256;[A-Za-z0-9_-]{43}$"
        },
        "role": {
          "enum": [
            "json-schema",
            "shacl",
            "context",
            "other"
          ]
        },
        "slot": {
          "type": "string",
          "minLength": 1
        },
        "applies_to": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "dsp_message",
              "policy_intake",
              "catalog_entry",
              "agreement_admission"
            ]
          }
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "source": {
          "type": "string",
          "format": "iri"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "media_type": {
                "const": "application/ld+json"
              }
            }
          },
          "then": {
            "required": [
              "url"
            ]
          }
        }
      ]
    }
  }
}
