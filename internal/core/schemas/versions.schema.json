{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/alexandria-vhub/schemas/versions/v1",
  "title": "Listado de versiones v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "@context",
    "type",
    "issuer",
    "validFrom",
    "credentialSubject",
    "proof",
    "validUntil"
  ],
  "properties": {
    "@context": {
      "type": "array",
      "prefixItems": [
        {
          "const": "https://www.w3.org/ns/credentials/v2"
        },
        {
          "type": "string",
          "format": "iri"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "type": {
      "type": "array",
      "prefixItems": [
        {
          "const": "VerifiableCredential"
        },
        {
          "const": "VersionListing"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "issuer": {
      "type": "string",
      "pattern": "^did:(web:[A-Za-z0-9._%:-]+|key:z[1-9A-HJ-NP-Za-km-z]+)$"
    },
    "validFrom": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "credentialSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "namespace",
        "sequence",
        "versions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "iri"
        },
        "namespace": {
          "type": "string",
          "format": "iri"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/record"
          }
        }
      }
    },
    "proof": {
      "$ref": "#/$defs/proof"
    },
    "validUntil": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "$defs": {
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "cryptosuite",
        "created",
        "verificationMethod",
        "proofPurpose",
        "proofValue"
      ],
      "properties": {
        "type": {
          "const": "DataIntegrityProof"
        },
        "cryptosuite": {
          "const": "eddsa-jcs-2022"
        },
        "created": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "verificationMethod": {
          "type": "string",
          "pattern": "^did:(web|key):[^#]+#.+$"
        },
        "proofPurpose": {
          "const": "assertionMethod"
        },
        "proofValue": {
          "type": "string",
          "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$"
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "namespace",
        "version",
        "manifest",
        "class",
        "published_at",
        "new_content_from",
        "enforced_from",
        "revoked_from"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "iri"
        },
        "namespace": {
          "type": "string",
          "format": "iri"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
        },
        "manifest": {
          "type": "string",
          "pattern": "^ni:///sha-256;[A-Za-z0-9_-]{43}$"
        },
        "class": {
          "enum": [
            "initial",
            "compatible",
            "breaking"
          ]
        },
        "published_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "new_content_from": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "enforced_from": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "revoked_from": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
